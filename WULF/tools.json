      "repo": "dualface/qscreen",
      "assetRegex": "^qscn-windows-amd64\\.exe\\.gz$",
      "target": "binaries\\qscn.exe",
      "detectPath": "binaries\\qscn.exe",
      "managedPaths": ["binaries\\qscn.exe"]
    },
    {
      "id": "you-get",
      "name": "you-get",
      "menu": true,
      "defaultSelected": true,
      "homepage": "https://github.com/soimort/you-get",
