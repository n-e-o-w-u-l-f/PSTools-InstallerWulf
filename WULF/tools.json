{
  "schemaVersion": 1,
  "defaults": {
    "basePath": "C:\\PS",
    "binariesPath": "C:\\PS\\binaries"
  },
  "tools": [
    {
      "id": "yt-dlp",
      "name": "yt-dlp",
      "menu": true,
      "defaultSelected": true,
      "homepage": "https://github.com/yt-dlp/yt-dlp",
      "installType": "github-exe",
      "repo": "yt-dlp/yt-dlp",
      "assetRegex": "^yt-dlp\\.exe$",
      "target": "binaries\\yt-dlp.exe",
      "detectPath": "binaries\\yt-dlp.exe",
      "managedPaths": ["binaries\\yt-dlp.exe"]
    },
    {
      "id": "tdl",
      "name": "tdl",
      "menu": true,
      "defaultSelected": true,
      "homepage": "https://github.com/iyear/tdl",
      "installType": "github-zip-single",
      "repo": "iyear/tdl",
      "assetRegex": "^tdl_Windows_64bit\\.zip$",
      "extractName": "tdl.exe",
      "target": "binaries\\tdl.exe",
      "detectPath": "binaries\\tdl.exe",
      "managedPaths": ["binaries\\tdl.exe"]
    },
    {
      "id": "tdl-companionwulf",
      "name": "tdl-CompanionWulf (uses tdl)",
      "menu": true,
      "defaultSelected": false,
      "homepage": "https://github.com/n-e-o-w-u-l-f/tdl-CompanionWulf",
      "installType": "pip-venv",
      "package": "https://github.com/n-e-o-w-u-l-f/tdl-CompanionWulf/archive/refs/heads/main.zip",
      "command": "tdl-companionwulf",
      "target": "tools\\tdl-CompanionWulf",
      "detectPath": "binaries\\tdl-companionwulf.cmd",
      "managedPaths": ["tools\\tdl-CompanionWulf", "binaries\\tdl-companionwulf.cmd"],
      "requires": "python"
    },
    {
      "id": "qscreen",
      "name": "qscreen (qscn)",
      "menu": true,
      "defaultSelected": false,
      "homepage": "https://github.com/dualface/qscreen",
